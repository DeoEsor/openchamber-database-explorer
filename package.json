{
  "name": "openchamber-db-connect",
  "version": "1.2.0",
  "description": "A DataGrip-inspired workspace for OpenChamber with PostgreSQL editing and SQL, MongoDB documents, and Redis/Valkey browsing.",
  "author": "DeoEsor <RuilanValeriy@yandex.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeoEsor/openchamber-database-explorer.git"
  },
  "keywords": [
    "openchamber",
    "database",
    "postgresql",
    "mongodb",
    "redis",
    "valkey",
    "database-explorer",
    "datagrip"
  ],
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "db-connect",
        "name": "Database Explorer",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {}
      },
      "attach": false
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@openchamber/sdk": "^2.6.0",
    "mongodb": "^7.9.0",
    "postgres": "^3.4.5",
    "redis": "^6.3.1"
  }
}
